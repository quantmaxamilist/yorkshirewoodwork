---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import ProductCard from '../../components/ProductCard.astro';
import EnquiryForm from '../../components/EnquiryForm.astro';
import { products, categories, price, site, type Product } from '../../data/site';

export function getStaticPaths() {
  return products.map((p) => ({ params: { slug: p.slug }, props: { p } }));
}
interface Props { p: Product }
const { p } = Astro.props;
const catLabel = categories.find((c) => c.key === p.cat)?.label ?? '';
const related = products.filter((x) => x.cat === p.cat && x.slug !== p.slug).concat(products.filter((x) => x.cat !== p.cat)).slice(0, 4);
const schema = [
  {
    '@context': 'https://schema.org', '@type': 'Product', name: p.name, description: p.summary,
    image: p.images.map((i) => new URL(i.src, site.url).href), material: p.timber,
    brand: { '@type': 'Brand', name: site.name },
    offers: { '@type': 'Offer', priceCurrency: 'GBP', price: p.price.toFixed(2), availability: 'https://schema.org/MadeToOrder', url: `${site.url}/shop/${p.slug}/`, seller: { '@id': `${site.url}/#business` } },
  },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Shop', item: `${site.url}/shop/` },
    { '@type': 'ListItem', position: 2, name: p.name, item: `${site.url}/shop/${p.slug}/` },
  ] },
];
---
<Base title={`${p.name} — ${price(p.price)} | Yorkshire Woodwork`} description={`${p.summary} Handmade in our West Yorkshire workshop.`} image={p.images[0].src} schema={schema}>
  <div class="wrap pt-8">
    <nav aria-label="Breadcrumb" class="text-sm muted"><a href="/shop/" class="link-u">Shop</a> <span class="mx-2">/</span> <a href={`/shop/?room=${p.cat}`} class="link-u">{catLabel}</a></nav>
  </div>

  <section class="wrap grid gap-10 lg:gap-16 lg:grid-cols-[1.25fr_1fr] pt-8 pb-24">
    <!-- Gallery -->
    <div class="gal" data-gal>
      <div class="frame gal__main">
        {p.images.map((im, i) => <img src={im.src} alt={`${p.name}${i ? ` — photo ${i + 1}` : ''}`} width={im.w} height={im.h} class:list={['gal__img', { on: i === 0 }]} loading={i === 0 ? 'eager' : 'lazy'} />)}
        {p.images.length > 1 && (
          <>
            <button class="gal__nav gal__prev" data-prev aria-label="Previous photo"><Icon name="chevL" size={22} /></button>
            <button class="gal__nav gal__next" data-next aria-label="Next photo"><Icon name="chevR" size={22} /></button>
            <span class="gal__count stamp" data-count>1 / {p.images.length}</span>
          </>
        )}
      </div>
      {p.images.length > 1 && (
        <div class="gal__thumbs">
          {p.images.map((im, i) => <button class:list={['gal__thumb frame', { on: i === 0 }]} data-thumb={i} aria-label={`Show photo ${i + 1}`}><img src={im.src} alt="" loading="lazy" width={im.w} height={im.h} /></button>)}
        </div>
      )}
    </div>

    <!-- Details -->
    <div class="lg:sticky lg:top-[calc(var(--hdr)+28px)] self-start">
      {p.badge && <p class="stamp text-oak mb-4">{p.badge}</p>}
      <h1 class="h-lg">{p.name}</h1>
      <p class="stamp stamp--lg mt-5 mb-6 text-[2rem]">{price(p.price)}</p>
      <p class="lede m-0">{p.summary}</p>

      <div class="spec mt-9">
        <div class="spec__row"><span>Timber</span><span>{p.timber}</span></div>
        {p.dims.map(([k, v]) => <div class="spec__row"><span>{k}</span><span>{v}</span></div>)}
      </div>

      <div class="flex flex-wrap gap-3 mt-9">
        <a href="#order" class="btn">Enquire to order <Icon name="arrow" size={18} /></a>
        <a href={site.mobileHref} class="btn btn--ghost"><Icon name="phone" size={18} /> {site.mobile}</a>
      </div>
      <p class="muted text-sm mt-4">Made to order by hand. Custom sizes available on request.</p>

      <div class="mt-10 grid gap-4 text-[1rem] leading-relaxed">
        {p.body.map((t) => <p class="m-0">{t}</p>)}
      </div>
      {p.options && (
        <div class="mt-8">
          <p class="stamp mb-3">Willow grades</p>
          <ul class="list-none m-0 p-0 grid gap-2">{p.options.map((o) => <li class="flex gap-3"><Icon name="bat" size={18} class="text-forest shrink-0 mt-1" />{o}</li>)}</ul>
        </div>
      )}
    </div>
  </section>

  <section class="sec sec--dark" id="order">
    <div class="wrap grid gap-12 lg:grid-cols-[1fr_1.4fr]">
      <div>
        <p class="stamp kicker text-honey">Order or ask a question</p>
        <h2 class="h-lg">Enquire about the {p.name.toLowerCase()}.</h2>
        <p class="muted mt-6">Tell us the size, finish and anything else you need and we’ll come back to you to confirm your order.</p>
      </div>
      <EnquiryForm dark product={p.name} />
    </div>
  </section>

  <section class="sec">
    <div class="wrap">
      <h2 class="h-md mb-10">You might also like</h2>
      <div class="grid gap-x-6 gap-y-12 grid-cols-2 lg:grid-cols-4">{related.map((r) => <ProductCard p={r} />)}</div>
    </div>
  </section>
</Base>

<style>
  .gal__main { aspect-ratio: 4 / 5; position: relative; background: var(--sawdust); }
  .gal__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0; transition: opacity .55s var(--ease) !important; }
  .gal__img.on { opacity: 1; }
  .gal__nav { position: absolute; top: 50%; transform: translateY(-50%); width: 46px; height: 46px; border-radius: 999px; border: 0; background: rgba(246,241,231,.9); color: var(--char); display: grid; place-items: center; cursor: pointer; z-index: 2; }
  .gal__prev { left: 14px; } .gal__next { right: 14px; }
  .gal__count { position: absolute; right: 14px; bottom: 14px; background: var(--char); color: var(--paper); padding: 7px 10px; z-index: 2; }
  .gal__thumbs { display: grid; grid-template-columns: repeat(auto-fill, minmax(72px, 1fr)); gap: 10px; margin-top: 12px; }
  .gal__thumb { aspect-ratio: 1; padding: 0; border: 0; cursor: pointer; opacity: .55; transition: opacity .3s; outline-offset: 2px; }
  .gal__thumb.on { opacity: 1; outline: 1.5px solid var(--char); }
  .spec { border-top: 1.5px solid var(--char); }
  .spec__row { display: grid; grid-template-columns: 110px 1fr; gap: 16px; padding: 12px 0; border-bottom: 1px solid var(--line); font-size: .97rem; }
  .spec__row span:first-child { font-family: 'Big Shoulders Stencil Display', sans-serif; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; font-size: .8rem; padding-top: 3px; opacity: .7; }
</style>

<script>
  const root = document.querySelector('[data-gal]');
  if (root) {
    const imgs = [...root.querySelectorAll<HTMLImageElement>('.gal__img')];
    const thumbs = [...root.querySelectorAll<HTMLButtonElement>('[data-thumb]')];
    const count = root.querySelector('[data-count]');
    let i = 0;
    const go = (n: number) => {
      i = (n + imgs.length) % imgs.length;
      imgs.forEach((im, k) => im.classList.toggle('on', k === i));
      thumbs.forEach((t, k) => t.classList.toggle('on', k === i));
      if (count) count.textContent = `${i + 1} / ${imgs.length}`;
    };
    thumbs.forEach((t, k) => t.addEventListener('click', () => go(k)));
    root.querySelector('[data-prev]')?.addEventListener('click', () => go(i - 1));
    root.querySelector('[data-next]')?.addEventListener('click', () => go(i + 1));
    let x0 = 0;
    root.querySelector('.gal__main')?.addEventListener('touchstart', (e) => { x0 = (e as TouchEvent).touches[0].clientX; }, { passive: true });
    root.querySelector('.gal__main')?.addEventListener('touchend', (e) => { const dx = (e as TouchEvent).changedTouches[0].clientX - x0; if (Math.abs(dx) > 40) go(i + (dx < 0 ? 1 : -1)); });
  }
</script>
