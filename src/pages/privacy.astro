---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import { site } from '../data/site';
---
<Base title="Privacy | Yorkshire Woodwork" description="How Yorkshire Woodwork LTD handles personal information sent through this website.">
  <PageHead kicker="Privacy" title="Privacy policy." />
  <section class="pb-28">
    <div class="wrap max-w-[760px] grid gap-5 text-[1.05rem]">
      <p><strong>Who we are.</strong> {site.legal}, West Yorkshire. Website: {site.url}.</p>
      <h2 class="h-md mt-4">What we collect</h2>
      <p class="m-0">When you send an enquiry through this website we receive the details you enter — your name, email address, phone number and message. We use these only to reply to you and to deal with any order or work you ask us about.</p>
      <h2 class="h-md mt-4">How forms are delivered</h2>
      <p class="m-0">Enquiry forms are delivered to our inbox by Web3Forms, a form-processing service, which passes your details on to us only to deliver the message.</p>
      <h2 class="h-md mt-4">Cookies</h2>
      <p class="m-0">This website does not use advertising or tracking cookies.</p>
      <h2 class="h-md mt-4">Your rights</h2>
      <p class="m-0">You can ask to see, correct or delete the personal information we hold about you by emailing <a class="link-u" href={`mailto:${site.email}`}>{site.email}</a>.</p>
    </div>
  </section>
</Base>
