---
// Rotating circular stamp: the company's own line around their tree mark.
interface Props { size?: number; class?: string; text?: string }
const { size = 150, class: cls = '', text = 'Proper Yorkshire Joinery · Handmade in West Yorkshire · ' } = Astro.props;
const id = 'seal-' + Math.random().toString(36).slice(2, 8);
---
<div class={`relative ${cls}`} style={`width:${size}px;height:${size}px`} aria-hidden="true">
  <svg viewBox="0 0 200 200" class="absolute inset-0 w-full h-full spin">
    <defs><path id={id} d="M100,100 m-78,0 a78,78 0 1,1 156,0 a78,78 0 1,1 -156,0" /></defs>
    <text style="font-family:'Big Shoulders Stencil Display',Impact,sans-serif;font-weight:800;letter-spacing:.24em;text-transform:uppercase" font-size="15.5" fill="currentColor">
      <textPath href={`#${id}`}>{text}</textPath>
    </text>
  </svg>
  <svg viewBox="0 0 24 24" class="absolute" style="inset:31%" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round">
    <path d="M12 21v-7"/><path d="M12 14c-1.6-2-4.5-2.5-6-1.5M12 14c1.6-2 4.5-2.5 6-1.5M12 11V7M12 9c-1.3-1.5-3-2-4.5-1.6M12 9c1.3-1.5 3-2 4.5-1.6"/><circle cx="12" cy="11" r="8.5"/>
  </svg>
</div>
