---
import { price, type Product } from '../data/site';
interface Props { p: Product; eager?: boolean }
const { p, eager = false } = Astro.props;
const [a, b] = p.images;
---
<a href={`/shop/${p.slug}/`} class="pcard zoom" data-cat={p.cat}>
  <div class="frame pcard__media">
    {p.badge && <span class:list={['pcard__badge stamp', { 'pcard__badge--best': p.badge === 'Best seller' }]}>{p.badge}</span>}
    <img src={a.src} alt={p.name} width={a.w} height={a.h} loading={eager ? 'eager' : 'lazy'} />
    {b && <img src={b.src} alt="" width={b.w} height={b.h} loading="lazy" />}
    <div class="pcard__spec" aria-hidden="true">
      <p class="stamp opacity-70 m-0 mb-2">{p.timber}</p>
      {p.dims.slice(0, 3).map(([k, v]) => (
        <div class="dim text-[.78rem] leading-tight py-[3px]"><span class="opacity-70 w-[62px] shrink-0">{k}</span><span class="dim__line"></span><span class="font-medium whitespace-nowrap">{v}</span></div>
      ))}
    </div>
  </div>
  <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1 sm:gap-4 pt-4">
    <h3 class="font-serif text-[1.08rem] sm:text-[1.25rem] leading-tight m-0">{p.name}</h3>
    <span class="stamp stamp--lg shrink-0">{price(p.price)}</span>
  </div>
  <p class="muted text-sm mt-1 mb-0">{p.timber}</p>
</a>
